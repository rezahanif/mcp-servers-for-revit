{
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "id": "revit-mcp",
  "name": "Revit Connector",
  "version": "1.0.0",
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "node",
  "entry": "server/build/index.js",
  "min_app_version": "0.4.0",
  "entitlement_tier": "pro",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "host_plugin": {
    "type": "revit-addin",
    "host_app": "Autodesk Revit",
    "install_target_template": "%APPDATA%/Autodesk/Revit/Addins/{revit_version}/",
    "artifact": "RevitMCPPlugin-{revit_version}.zip",
    "requires_host_restart": true,
    "socket_port_env_var": "REVIT_SOCKET_PORT",
    "supported_versions": [
      "2023",
      "2024",
      "2025",
      "2026"
    ]
  },
  "tool_index": {
    "exec_tool": "send_code_to_revit",
    "capabilities_file": "server/build/tools/aiconnect-capabilities.json"
  },
  "config": {
    "env": []
  },
  "package": {
    "include": [
      "server/build",
      "RevitMCPPlugin-2023.zip",
      "RevitMCPPlugin-2024.zip",
      "RevitMCPPlugin-2025.zip",
      "RevitMCPPlugin-2026.zip"
    ],
    "exclude": [],
    "vendor": [
      "server/node_modules"
    ]
  },
  "tool_tiers": {
    "core": [
      "search_revit_api",
      "query_revit_registry",
      "list_revit_api_categories",
      "list_revit_templates",
      "query_stored_data",
      "send_code_to_revit",
      "get_current_view_info",
      "get_current_view_elements",
      "get_selected_elements",
      "get_available_family_types",
      "get_material_quantities",
      "create_point_based_element",
      "create_line_based_element",
      "create_surface_based_element",
      "create_room",
      "create_level",
      "set_parameter_value",
      "delete_element",
      "operate_element"
    ]
  }
}
