{
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "id": "revit-mcp",
  "name": "Revit Connector",
  "version": "1.0.0",
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "node",
  "entry": "server/build/index.js",
  "min_app_version": "0.4.0",
  "entitlement_tier": "pro",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "host_plugin": {
    "type": "revit-addin",
    "host_app": "Autodesk Revit",
    "install_target_template": "%APPDATA%/Autodesk/Revit/Addins/{revit_version}/",
    "artifact": "RevitMCPPlugin.zip",
    "requires_host_restart": true,
    "socket_port_env_var": "REVIT_SOCKET_PORT",
    "supported_versions": ["2023", "2024", "2025"]
  }
}
